# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_staging

# JWT Authentication Secret (32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://fundedshift:fundedshift_secret_2026@localhost:5432/fundedshift_db
POSTGRES_USER=fundedshift
POSTGRES_PASSWORD=fundedshift_secret_2026
POSTGRES_DB=fundedshift_db

